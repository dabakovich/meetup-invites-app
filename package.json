{
  "name": "tusovka",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/@react-router/dev/bin.js dev",
    "build": "react-router build",
    "start": "node --env-file-if-exists=.env scripts/serve.mjs",
    "seed": "node --env-file-if-exists=.env --experimental-strip-types scripts/seed.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "predev": "npm run seed",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@react-router/express": "^7.18.0",
    "@react-router/node": "^7.18.0",
    "better-auth": "^1.4.0",
    "better-sqlite3": "^12.4.0",
    "express": "^5.1.0",
    "isbot": "^5",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.0",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
