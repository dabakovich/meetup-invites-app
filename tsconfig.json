{
  "include": [
    "app/**/*",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vite.config.ts",
    "react-router.config.ts",
    ".react-router/types/**/*"
  ],
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["node", "vite/client"],
    "rootDirs": [".", "./.react-router/types"],
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
